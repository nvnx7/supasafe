# Copy to .env and fill in. Devnet needs none of this — deploy.ts pulls a funded
# deployer from the node's predeployed accounts and uses throwaway owner keys.

# RPC endpoint. Defaults to http://127.0.0.1:5050/rpc on devnet.
# RPC_URL=https://free-rpc.nethermind.io/sepolia-juno/

# Deployer account. Required on every network except devnet.
# DEPLOYER_ADDRESS=0x...
# DEPLOYER_PRIVATE_KEY=0x...

# Owner STARK public keys for the deployed multisig, comma separated.
# Required on every network except devnet.
# MULTISIG_OWNERS=0x...,0x...,0x...

# Signatures required to authorize a transaction. Defaults to 2.
# MULTISIG_THRESHOLD=2
